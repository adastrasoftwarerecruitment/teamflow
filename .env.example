# ============================================================
# TeamFlow — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Session secret (generate a random 64-char string) ────────
SESSION_SECRET=changeme_generate_a_64_char_random_string_here_abc123

# ── Database ─────────────────────────────────────────────────
# Option A: Turso (free cloud SQLite — recommended for Render)
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Option B: Leave blank → falls back to local SQLite (data/teamflow.db)
# (Do NOT set TURSO_URL when using local SQLite)

# ── CORS (comma-separated allowed origins, besides localhost) ─
# Add your Render deployment URL here
CORS_ORIGINS=https://your-app.onrender.com

# ── Firebase Cloud Messaging (FCM) for push notifications ────
# Download your Firebase service account JSON and paste the path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR paste the JSON content as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}

# ── Capacitor API URL ─────────────────────────────────────────
# Set this in your index.html via window.__TEAMFLOW_API or leave
# config.js to use relative URLs (web) / env variable (native)
# VITE_API_URL is not used — set __TEAMFLOW_API in public/js/config.js

# ── Admin seed account (used by scripts/seed.js only) ────────
SEED_ADMIN_PASSWORD=AdminPass123!

# ── Optional: Render keep-alive ping interval (minutes) ──────
# Use cron-job.org to ping /healthz every 10 minutes
